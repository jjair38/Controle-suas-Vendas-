rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Order Validation ---
    function isValidOrder(data) {
      return data.userId == request.auth.uid &&
             data.marketplace in ['Shopee', 'Mercado Livre'] &&
             data.orderId is string && data.orderId.size() <= 100 &&
             data.product is string && data.product.size() <= 200 &&
             data.quantity is number && data.quantity > 0 &&
             data.saleValue is number &&
             data.date is string;
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && isValidOrder(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && 
                       isValidOrder(incoming()) && incoming().updatedAt == request.time &&
                       incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // --- Product Validation ---
    function isValidProduct(data) {
      return data.userId == request.auth.uid &&
             data.name is string && data.name.size() <= 200 &&
             data.sku is string && data.sku.size() <= 100;
    }

    match /products/{productId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && isValidProduct(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && 
                       isValidProduct(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // --- Settings Validation ---
    match /settings/{settingId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow write: if isSignedIn() && incoming().userId == request.auth.uid;
    }

    // --- Materials Validation ---
    match /materials/{materialId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && 
                       incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
